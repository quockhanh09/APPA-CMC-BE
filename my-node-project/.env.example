PORT=4000
# Public backend origin; set this to the permanent HTTPS domain used by QR links.
PUBLIC_BASE_URL=https://api.example.com
# Supabase: lấy tại Project Settings → API. Dùng SERVICE ROLE KEY (không phải anon key)
# vì backend cần đọc/ghi mọi bảng bất kể RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
